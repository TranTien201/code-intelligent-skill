diff --git a/After/src/print/density.c b/After/src/print/density.c
new file mode 100644
index 0000000..f1fb74a
--- /dev/null
+++ b/After/src/print/density.c
@@ -0,0 +1,7 @@
+#include "density.h"
+#include "../util/math_util.h"
+
+int Density_Scale(int base, int percent)
+{
+    return Clamp(base * percent / 100, 0, DENSITY_MAX);
+}
